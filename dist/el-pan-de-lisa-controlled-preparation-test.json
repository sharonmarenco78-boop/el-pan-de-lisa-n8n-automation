          "message": "=<div style=\"font-family:Arial,sans-serif;max-width:640px;margin:auto;color:#5b2b18\">\n  <h1>El Pan de Lisa</h1>\n  <h2>👩‍🍳 ¡Tu pedido está en preparación!</h2>\n  <p>Hola {{ $json.Nombre }}, estamos preparando tu pedido con mucho cariño.</p>\n  <p><strong>Pedido:</strong> {{ $json.NumeroOrden }}</p>\n</div>\n",
          "options": {}
        },
