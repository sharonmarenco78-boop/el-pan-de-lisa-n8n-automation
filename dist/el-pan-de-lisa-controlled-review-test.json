        "name": "Unir Pedidos y Log"
      },
      {
        "parameters": {
          "jsCode": "const pedidos = items.filter(i => i.json.__kind === 'pedido');\nconst pedido = pedidos.find(i => String(i.json['N.º de orden'] ?? '').trim() === \"EXAMPLE-ORDER\");\nif (!pedido || pedido.json.Estado !== 'Entregado') return [];\nconst order = String(pedido.json['N.º de orden']).trim();\nconst products = [];\nif (Number(pedido.json['Cantidad Pan Blanco'] ?? 0) > 0) products.push('Pan Blanco');\nif (Number(pedido.json['Cantidad Pan Semi Integral'] ?? 0) > 0) products.push('Pan Semi Integral');\nconst product = products.join(' + ') || 'Producto no identificado';\nconst query = ['usp=pp_url','entry.950326924='+encodeURIComponent(order),'entry.1893454218='+encodeURIComponent(pedido.json.Nombre ?? ''),'entry.1903981963='+encodeURIComponent(product),'entry.732910652='+encodeURIComponent(pedido.json.Correo ?? '')].join('&');\nreturn [{ json: { ...pedido.json, NumeroOrden: order, Producto: product, ReviewURL: \"https://docs.google.com/forms/d/e/example-form-id/viewform?\" + '?' + query } }];"
        },
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          -120,
          0
        ],
        "id": "59c33815-7e4c-48df-9ec0-0ae889604ce3",
        "name": "Seleccionar reviews vencidos"
      },
      {
        "parameters": {
          "sendTo": "={{ $json.Correo }}",
          "subject": "=PRUEBA — ¿Cómo estuvo tu pedido? — Pedido {{ $json.NumeroOrden }}",
          "emailType": "html",
          "message": "=<div style=\"font-family:Arial,sans-serif;max-width:640px;margin:auto;color:#5b2b18\">\n  <h1>El Pan de Lisa</h1>\n  <h2>¿Cómo estuvo tu pedido?</h2>\n  <p>Hola {{ $json.Nombre }}, nos encantaría conocer tu opinión.</p>\n  <p><a href=\"{{ $json.ReviewURL }}\">Dejar una reseña</a></p>\n  <p><strong>Pedido:</strong> {{ $json.NumeroOrden }}</p>\n</div>\n",
          "options": {}
        },
        "type": "n8n-nodes-base.gmail",
        "typeVersion": 2.2,
