          "message": "=<div style=\"font-family:Arial,sans-serif;max-width:640px;margin:auto;color:#5b2b18\">\n  <h1>El Pan de Lisa</h1>\n  <h2>✅ ¡Tu pedido está listo!</h2>\n  <p>Hola {{ $json.Nombre }}, tu pedido ya está listo.</p>\n  <p><strong>Pedido:</strong> {{ $json.NumeroOrden }}</p>\n</div>\n",
          "options": {}
        },
