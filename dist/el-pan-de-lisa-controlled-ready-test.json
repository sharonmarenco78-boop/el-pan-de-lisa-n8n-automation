        "name": "Unir Pedidos y Log"
      },
      {
        "parameters": {
          "jsCode": "const pedidos = items.filter(i => i.json.__kind === 'pedido');\nconst logs = items.filter(i => i.json.__kind === 'log');\nconst sent = new Set(logs.filter(i => i.json.Evento === 'ready_email' && i.json.Resultado === 'Enviado').map(i => String(i.json['N.º de orden'] ?? '').trim()));\nconst claimed = new Set(sent);\nreturn pedidos.filter(i => i.json.Estado === 'Listo').map(i => {\n  const key = Object.keys(i.json).find(k => k.normalize('NFC').trim() === 'N.º de orden');\n  const order = String(key ? i.json[key] : '').trim();\n  if (!order || claimed.has(order)) return null;\n  claimed.add(order);\n  const json = { ...i.json, 'N.º de orden': order, NumeroOrden: order };\n  delete json.__kind;\n  return { json };\n}).filter(Boolean).filter(i => i.json.NumeroOrden === \"EXAMPLE-ORDER\");"
        },
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          -120,
          0
        ],
